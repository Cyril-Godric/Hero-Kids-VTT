<form class="{{cssClass}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="80" width="80"/>
    <div class="header-fields">
      <h1><input name="name" type="text" value="{{actor.name}}" placeholder="Hero Name"/></h1>
      <div class="health-bar">
        <label>Health Boxes:</label>
        <input type="number" name="system.health.value" value="{{system.health.value}}" min="0" max="10"/>
        <span> / </span>
        <input type="number" name="system.health.max" value="{{system.health.max}}" min="1" max="10"/>
      </div>
    </div>
  </header>

  <section class="pools-grid">
    <div class="pool-card">
      <button type="button" class="roll-pool" data-pool="melee">⚔️ Melee</button>
      <input type="number" name="system.pools.melee" value="{{system.pools.melee}}" min="0" max="6"/>
    </div>
    <div class="pool-card">
      <button type="button" class="roll-pool" data-pool="ranged">🏹 Ranged</button>
      <input type="number" name="system.pools.ranged" value="{{system.pools.ranged}}" min="0" max="6"/>
    </div>
    <div class="pool-card">
      <button type="button" class="roll-pool" data-pool="magic">✨ Magic</button>
      <input type="number" name="system.pools.magic" value="{{system.pools.magic}}" min="0" max="6"/>
    </div>
    <div class="pool-card">
      <button type="button" class="roll-pool" data-pool="armor">🛡️ Armor</button>
      <input type="number" name="system.pools.armor" value="{{system.pools.armor}}" min="0" max="6"/>
    </div>
  </section>

  <section class="sheet-body">
    <div class="items-header">
      <h3>Powers & Special Actions</h3>
      <a class="item-create" data-type="power">+ Add Power</a>
    </div>
    <ol class="items-list">
      {{#each powers as |item|}}
      <li class="item flexrow" data-item-id="{{item._id}}">
        <span class="item-name">{{item.name}}</span>
        <div class="item-controls">
          <a class="item-edit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-delete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>
  </section>
</form>